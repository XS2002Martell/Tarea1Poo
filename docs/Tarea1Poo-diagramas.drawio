        <mxCell id="Main" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:center;&quot;&gt;&lt;b&gt;Main&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ CARPETA_DATOS: String {static final} = &quot;datos&quot;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ main(args: String[]): void&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   captura PersistenciaException (no usa throws)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pkg_raiz"><mxGeometry x="20" y="44" width="330" height="104" as="geometry"/></mxCell>
