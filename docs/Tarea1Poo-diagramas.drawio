        <mxCell id="p4s" value="Un solo actor humano: el encargado de inventario opera el sistema por consola. Los numeros entre parentesis son la opcion del menu." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1600" height="24" as="geometry"/></mxCell>
