        <mxCell id="uc4" value="Registrar entrada  (7)" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="frontera"><mxGeometry x="50" y="394" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="uc5" value="Registrar salida  (8)" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="frontera"><mxGeometry x="50" y="502" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="uc6" value="Buscar producto por codigo  (4)" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="frontera"><mxGeometry x="50" y="610" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="uc7" value="Consultar kardex de un producto  (9)" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="frontera"><mxGeometry x="50" y="718" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="uc8" value="Buscar producto por nombre  (5)" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="frontera"><mxGeometry x="50" y="826" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="uc9" value="Consultar inventario: catalogo + saldos  (6)" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="frontera"><mxGeometry x="50" y="934" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="uc10" value="Crear respaldo de datos  (10)" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="frontera"><mxGeometry x="50" y="1042" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="uc11" value="Cargar datos al iniciar" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="frontera"><mxGeometry x="50" y="1150" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="in1" value="Validar datos de entrada" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="frontera"><mxGeometry x="480" y="215" width="340" height="72" as="geometry"/></mxCell>
        <mxCell id="in2" value="Verificar que el producto exista" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="frontera"><mxGeometry x="480" y="540" width="340" height="72" as="geometry"/></mxCell>
        <mxCell id="in3" value="Guardar cambios en los archivos" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="frontera"><mxGeometry x="480" y="860" width="340" height="72" as="geometry"/></mxCell>
        <mxCell id="ex4" value="Rechazar codigo duplicado" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="frontera"><mxGeometry x="900" y="40" width="380" height="72" as="geometry"/></mxCell>
        <mxCell id="ex1" value="Rechazar dato invalido" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="frontera"><mxGeometry x="900" y="215" width="380" height="72" as="geometry"/></mxCell>
        <mxCell id="ex2" value="Avisar producto inexistente" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="frontera"><mxGeometry x="900" y="540" width="380" height="72" as="geometry"/></mxCell>
        <mxCell id="ex3" value="Informar error de archivo" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="frontera"><mxGeometry x="900" y="860" width="380" height="72" as="geometry"/></mxCell>
