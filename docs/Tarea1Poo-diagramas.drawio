        <mxCell id="MenuConsola" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:center;&quot;&gt;&lt;b&gt;MenuConsola&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- LINEA_INVENTARIO: String {static final}&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- LINEA_KARDEX: String {static final}&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- servicio: InventarioService {final}&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- entrada: Scanner {final}&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ MenuConsola(servicio: InventarioService)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ iniciar(): void&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   aqui se CAPTURAN todas las excepciones&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- mostrarMenu(): void&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- registrarProducto(): void&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      throws CodigoDuplicadoException, PersistenciaException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- modificarProducto(): void&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      throws ProductoNoEncontradoException, PersistenciaException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- eliminarProducto(): void&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      throws ProductoNoEncontradoException,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      IntegridadReferencialException, PersistenciaException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- buscarPorCodigo(): void throws ProductoNoEncontradoException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- buscarPorNombre(): void&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- consultarInventario(): void&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- registrarEntrada(): void&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      throws ProductoNoEncontradoException, PersistenciaException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- registrarSalida(): void&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      throws ProductoNoEncontradoException,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      StockInsuficienteException, PersistenciaException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- consultarKardex(): void throws ProductoNoEncontradoException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- crearRespaldo(): void throws PersistenciaException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- leerTexto(mensaje: String): String&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- leerEntero(mensaje: String): int&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- leerDecimal(mensaje: String): double&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- pausar(): void&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- recortar(texto: String, largoMaximo: int): String&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pkg_vista"><mxGeometry x="20" y="44" width="400" height="538" as="geometry"/></mxCell>
        <mxCell id="pkg_servicio" value="servicio" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=110;tabHeight=22;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;fillColor=none;strokeColor=#6c6c6c;dashed=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="530" y="90" width="510" height="672" as="geometry"/></mxCell>
        <mxCell id="InventarioService" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:center;&quot;&gt;&lt;b&gt;InventarioService&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- cataInventRepo: CataInventRepo {final}&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- saldosRepo: SaldosRepo {final}&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- kardexRepo: KardexRepo {final}&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- catalogo: Map&amp;lt;String, CataInvent&amp;gt; {final}&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- saldos: Map&amp;lt;String, SaldosInventario&amp;gt; {final}&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- listaKardex: List&amp;lt;Kardex&amp;gt; {final}&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- advertencias: List&amp;lt;String&amp;gt; {final}&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ InventarioService(carpetaDatos: Path)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      throws PersistenciaException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- cargarDatos(): void throws PersistenciaException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ getAdvertencias(): List&amp;lt;String&amp;gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ registrarProducto(codInvent: String, nombre: String): void&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      throws CodigoDuplicadoException, PersistenciaException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ modificarProducto(codInvent: String, nuevoNombre: String): void&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      throws ProductoNoEncontradoException, PersistenciaException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ eliminarProducto(codInvent: String): void&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      throws ProductoNoEncontradoException,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      IntegridadReferencialException, PersistenciaException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ buscarProducto(codInvent: String): CataInvent&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      throws ProductoNoEncontradoException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ buscarPorNombre(texto: String): List&amp;lt;CataInvent&amp;gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ listarCatalogo(): List&amp;lt;CataInvent&amp;gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ registrarEntrada(codInvent: String, cantidad: int,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      precioUnitario: double): void&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      throws ProductoNoEncontradoException, PersistenciaException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ registrarSalida(codInvent: String, cantidad: int): void&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      throws ProductoNoEncontradoException,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      StockInsuficienteException, PersistenciaException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ consultarSaldo(codInvent: String): SaldosInventario&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      throws ProductoNoEncontradoException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ listarSaldos(): List&amp;lt;SaldosInventario&amp;gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ consultarKardex(codInvent: String): List&amp;lt;Kardex&amp;gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      throws ProductoNoEncontradoException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ respaldarDatos(): List&amp;lt;Path&amp;gt; throws PersistenciaException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- guardarCatalogo(): void throws PersistenciaException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- guardarSaldos(): void throws PersistenciaException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- guardarKardex(): void throws PersistenciaException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- siguienteCodigoSaldo(): int&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- siguienteCodigoKardex(): int&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="pkg_servicio"><mxGeometry x="20" y="44" width="470" height="608" as="geometry"/></mxCell>
        <mxCell id="notaRev" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;Reversion ante error de escritura (simula una transaccion)&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Antes de guardar, el servicio copia el saldo con copiar().&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Si guardarXxx() lanza PersistenciaException:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   1. devuelve el saldo anterior al Map,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   2. quita el movimiento de listaKardex,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   3. relanza con throw e.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Asi memoria y archivos nunca quedan desfasados.&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;dashed=0;" vertex="1" parent="1"><mxGeometry x="550" y="792" width="470" height="135" as="geometry"/></mxCell>
        <mxCell id="pkg_persistencia" value="persistencia" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=110;tabHeight=22;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;fillColor=none;strokeColor=#6c6c6c;dashed=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1090" y="90" width="490" height="890" as="geometry"/></mxCell>
        <mxCell id="ArchivoTxt" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:center;&quot;&gt;&lt;i&gt;&amp;#171;abstract&amp;#187;&lt;/i&gt;&lt;br/&gt;&lt;b&gt;ArchivoTxt&amp;lt;T&amp;gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ EXTENSION_TEMPORAL: String {static final} = &quot;.tmp&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ CARPETA_RESPALDOS: String {static final} = &quot;respaldos&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- FORMATO_MARCA_TIEMPO: DateTimeFormatter {static final}&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;# ruta: Path {final}&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- advertencias: List&amp;lt;String&amp;gt; {final}&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;# ArchivoTxt(ruta: Path)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;# parsear(linea: String): T {abstract}&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;# serializar(entidad: T): String {abstract}&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ getAdvertencias(): List&amp;lt;String&amp;gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ getRuta(): Path&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;# crearSiNoExiste(): void throws PersistenciaException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      NIO.2: Files.createDirectories / notExists / createFile&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ leerTodos(): List&amp;lt;T&amp;gt; throws PersistenciaException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      try-with-resources + try/catch por linea&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ guardarTodos(registros: List&amp;lt;T&amp;gt;): void&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      throws PersistenciaException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      escritura segura con .tmp + Files.move y finally&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ respaldar(): Path throws PersistenciaException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      Java I/O clasico: File/FileReader/FileWriter + finally&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- cerrarSilenciosamente(recurso: Closeable): void {static}&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- nombreSinExtension(): String&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="pkg_persistencia"><mxGeometry x="20" y="44" width="450" height="370" as="geometry"/></mxCell>
        <mxCell id="CataInventRepo" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:center;&quot;&gt;&lt;b&gt;CataInventRepo extends ArchivoTxt&amp;lt;CataInvent&amp;gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ NOMBRE_ARCHIVO: String {static final} = &quot;catalogo.txt&quot;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ CataInventRepo(carpetaDatos: Path)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;# parsear(linea: String): CataInvent&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;# serializar(entidad: CataInvent): String&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="pkg_persistencia"><mxGeometry x="20" y="444" width="450" height="118" as="geometry"/></mxCell>
        <mxCell id="SaldosRepo" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:center;&quot;&gt;&lt;b&gt;SaldosRepo extends ArchivoTxt&amp;lt;SaldosInventario&amp;gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ NOMBRE_ARCHIVO: String {static final} = &quot;saldos.txt&quot;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ SaldosRepo(carpetaDatos: Path)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;# parsear(linea: String): SaldosInventario&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;# serializar(entidad: SaldosInventario): String&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="pkg_persistencia"><mxGeometry x="20" y="586" width="450" height="118" as="geometry"/></mxCell>
