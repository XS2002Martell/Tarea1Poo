        <mxCell id="CataInvent" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:center;&quot;&gt;&lt;b&gt;CataInvent&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ SEPARADOR: String {static final} = &quot;;&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ LARGO_MAXIMO_NOMBRE: int {static final} = 60&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- PATRON_CODIGO: Pattern {static final} = ^[A-Z0-9-]{3,15}$&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- codInvent: String {final}&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;- nombreInventario: String&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ CataInvent(codInvent: String, nombreInventario: String)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ normalizarCodigo(codInvent: String): String {static}&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ getCodInvent(): String&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ getNombreInventario(): String&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ setNombreInventario(nombreInventario: String): void&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ aLinea(): String&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ desdeLinea(linea: String): CataInvent {static}&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ toString(): String&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="pkg_modelo"><mxGeometry x="20" y="44" width="470" height="244" as="geometry"/></mxCell>
