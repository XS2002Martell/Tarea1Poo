        <mxCell id="r23" value="captura" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;endSize=8;" edge="1" parent="1" source="MenuConsola" target="e1_InventarioException"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="leyenda1" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;Leyenda&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Triangulo hueco  =  herencia (extends)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Rombo relleno    =  composicion (el servicio crea y posee sus repos)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Flecha simple    =  asociacion (guarda una referencia)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Flecha punteada  =  dependencia (lo usa o lo lanza)&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ public      - private      # protected&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;{static} {final} {abstract} se marcan entre llaves&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="936" width="440" height="157" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pag-excepciones" name="Jerarquia de excepciones">
    <mxGraphModel dx="1422" dy="798" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1550" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2t" value="Jerarquia de excepciones &amp;#183; verificadas vs no verificadas" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="34" as="geometry"/></mxCell>
        <mxCell id="p2s" value="En gris las clases del JDK. En color las siete excepciones propias del proyecto (paquete excepciones)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1400" height="24" as="geometry"/></mxCell>
        <mxCell id="Throwable" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:center;&quot;&gt;&lt;b&gt;java.lang.Throwable&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;getMessage() / getCause()&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#e8e8e8;strokeColor=#808080;dashed=0;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="Exception" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:center;&quot;&gt;&lt;b&gt;java.lang.Exception&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;&amp;amp;#171;verificada&amp;amp;#187;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#e8e8e8;strokeColor=#808080;dashed=0;" vertex="1" parent="1"><mxGeometry x="1080" y="190" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="InventarioException" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:center;&quot;&gt;&lt;b&gt;InventarioException&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;&amp;amp;#171;VERIFICADA&amp;amp;#187;  extends Exception&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ InventarioException(mensaje: String)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ InventarioException(mensaje: String, causa: Throwable)&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Base de todo el sistema. Al heredar de Exception&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;y no de RuntimeException, el compilador OBLIGA&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;a declararla con throws o a capturarla.&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;dashed=0;" vertex="1" parent="1"><mxGeometry x="420" y="320" width="380" height="151" as="geometry"/></mxCell>
        <mxCell id="exc_ProductoNoEncontradoException" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:center;&quot;&gt;&lt;b&gt;ProductoNoEncontradoException&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;&amp;amp;#171;verificada&amp;amp;#187;&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;El codigo buscado no existe en el catalogo.&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Se lanza en:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;InventarioService.buscarProducto() linea 220&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="275" height="123" as="geometry"/></mxCell>
        <mxCell id="exc_CodigoDuplicadoException" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:center;&quot;&gt;&lt;b&gt;CodigoDuplicadoException&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;&amp;amp;#171;verificada&amp;amp;#187;&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;El codigo ya existe al registrar un producto.&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Se lanza en:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;InventarioService.registrarProducto() linea 144&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;dashed=0;" vertex="1" parent="1"><mxGeometry x="335" y="620" width="275" height="137" as="geometry"/></mxCell>
        <mxCell id="exc_StockInsuficienteException" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:center;&quot;&gt;&lt;b&gt;StockInsuficienteException&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;&amp;amp;#171;verificada&amp;amp;#187;&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;La salida pide mas unidades que el saldo.&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Se lanza en:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;SaldosInventario.aplicarSalida() linea 87&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;dashed=0;" vertex="1" parent="1"><mxGeometry x="630" y="620" width="275" height="123" as="geometry"/></mxCell>
        <mxCell id="exc_IntegridadReferencialException" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:center;&quot;&gt;&lt;b&gt;IntegridadReferencialException&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;&amp;amp;#171;verificada&amp;amp;#187;&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Eliminar un producto con movimientos en kardex.&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Se lanza en:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;InventarioService.eliminarProducto() linea 193&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;dashed=0;" vertex="1" parent="1"><mxGeometry x="925" y="620" width="275" height="151" as="geometry"/></mxCell>
        <mxCell id="exc_PersistenciaException" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:center;&quot;&gt;&lt;b&gt;PersistenciaException&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;&amp;amp;#171;verificada&amp;amp;#187;&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Falla de lectura o escritura en los archivos.&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Se lanza en:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;ArchivoTxt lineas 103, 150, 190, 222, 249, 252&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ PersistenciaException(mensaje, causa)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;ENVUELVE la IOException como causa.&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;dashed=0;" vertex="1" parent="1"><mxGeometry x="1220" y="620" width="275" height="173" as="geometry"/></mxCell>
        <mxCell id="RuntimeException" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:center;&quot;&gt;&lt;b&gt;java.lang.RuntimeException&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;&amp;amp;#171;NO verificada&amp;amp;#187;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;El compilador no exige throws ni catch.&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#e8e8e8;strokeColor=#808080;dashed=0;" vertex="1" parent="1"><mxGeometry x="1700" y="320" width="280" height="79" as="geometry"/></mxCell>
        <mxCell id="DatosInvalidosException" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:center;&quot;&gt;&lt;b&gt;DatosInvalidosException&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;&amp;amp;#171;NO VERIFICADA&amp;amp;#187;  extends RuntimeException&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ DatosInvalidosException(mensaje)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;+ DatosInvalidosException(mensaje, causa)&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Toda validacion de datos: texto vacio, cantidad&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;negativa, codigo con formato malo, linea del&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;archivo mal formada.&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Se lanza en: CataInvent 36, 40, 59, 63, 68, 89, 94&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;SaldosInventario 29-41, 63, 67, 83, 155, 159, 173&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Kardex 31-45, 95, 99, 120&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Es NO verificada a proposito: un dato invalido puede&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;aparecer en cualquier constructor del modelo y llenar&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;de throws cada firma haria el codigo ilegible.&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#ffcccc;strokeColor=#b85450;dashed=0;" vertex="1" parent="1"><mxGeometry x="1560" y="620" width="300" height="307" as="geometry"/></mxCell>
        <mxCell id="IllegalArgumentException" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:center;&quot;&gt;&lt;b&gt;java.lang.IllegalArgumentException&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;&amp;amp;#171;NO verificada&amp;amp;#187;&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;La lanza TipoMovimiento.valueOf() cuando el&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;texto del archivo no es ENTRADA ni SALIDA.&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#e8e8e8;strokeColor=#808080;dashed=0;" vertex="1" parent="1"><mxGeometry x="1900" y="620" width="290" height="101" as="geometry"/></mxCell>
        <mxCell id="NumberFormatException" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:center;&quot;&gt;&lt;b&gt;java.lang.NumberFormatException&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;&amp;amp;#171;NO verificada&amp;amp;#187;  es HIJA de IllegalArgumentException&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;La lanzan Integer.parseInt y Double.parseDouble.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Se captura en MenuConsola.leerEntero (306) y&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;leerDecimal (320) para repetir la pregunta.&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#e8e8e8;strokeColor=#808080;dashed=0;" vertex="1" parent="1"><mxGeometry x="1900" y="790" width="290" height="143" as="geometry"/></mxCell>
        <mxCell id="DateTimeParseException" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:center;&quot;&gt;&lt;b&gt;java.time.format.DateTimeParseException&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;&amp;amp;#171;NO verificada&amp;amp;#187;&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;La lanza LocalDate.parse() con una fecha&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;que no respeta el formato ISO yyyy-MM-dd.&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#e8e8e8;strokeColor=#808080;dashed=0;" vertex="1" parent="1"><mxGeometry x="2230" y="620" width="290" height="101" as="geometry"/></mxCell>
        <mxCell id="IOException" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:center;&quot;&gt;&lt;b&gt;java.io.IOException&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;&amp;amp;#171;verificada&amp;amp;#187;&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;La lanzan Files, FileReader y FileWriter.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Nunca sale de la capa persistencia: se&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;envuelve en PersistenciaException.&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#e8e8e8;strokeColor=#808080;dashed=0;" vertex="1" parent="1"><mxGeometry x="1180" y="900" width="275" height="115" as="geometry"/></mxCell>
        <mxCell id="h1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=12;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="Exception" target="Throwable"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h2" value="extends" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=12;strokeWidth=1.5;" edge="1" parent="1" source="InventarioException" target="Exception"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h3" value="extends" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=12;strokeWidth=1.5;" edge="1" parent="1" source="RuntimeException" target="Exception"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h4" value="extends" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=12;strokeWidth=1.5;" edge="1" parent="1" source="exc_ProductoNoEncontradoException" target="InventarioException"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h5" value="extends" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=12;strokeWidth=1.5;" edge="1" parent="1" source="exc_CodigoDuplicadoException" target="InventarioException"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h6" value="extends" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=12;strokeWidth=1.5;" edge="1" parent="1" source="exc_StockInsuficienteException" target="InventarioException"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h7" value="extends" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=12;strokeWidth=1.5;" edge="1" parent="1" source="exc_IntegridadReferencialException" target="InventarioException"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h8" value="extends" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=12;strokeWidth=1.5;" edge="1" parent="1" source="exc_PersistenciaException" target="InventarioException"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h20" value="extends" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=12;strokeWidth=1.5;" edge="1" parent="1" source="DatosInvalidosException" target="RuntimeException"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h21" value="extends" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=12;strokeWidth=1.5;" edge="1" parent="1" source="IllegalArgumentException" target="RuntimeException"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h22" value="extends" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=12;strokeWidth=1.5;" edge="1" parent="1" source="NumberFormatException" target="IllegalArgumentException"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h23" value="extends" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=12;strokeWidth=1.5;" edge="1" parent="1" source="DateTimeParseException" target="RuntimeException"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h24" value="se envuelve como causa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;endSize=8;" edge="1" parent="1" source="IOException" target="exc_PersistenciaException"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2nota" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;Detalle importante del multi-catch (Kardex.desdeLinea, linea 119)&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;NO se puede escribir:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   catch (NumberFormatException | IllegalArgumentException e)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;porque NumberFormatException YA es hija de IllegalArgumentException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;y Java prohibe listar alternativas emparentadas en un multi-catch.&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Lo correcto, y lo que usa el codigo:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   catch (DateTimeParseException | IllegalArgumentException e)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;IllegalArgumentException cubre los dos casos: el parseInt/parseDouble&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;fallido y el TipoMovimiento.valueOf con un texto desconocido.&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="1085" width="620" height="171" as="geometry"/></mxCell>
        <mxCell id="p2nota2" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;Encadenamiento de excepciones (la causa)&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;IOException real en disco&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   ... se envuelve ...&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;throw new PersistenciaException(&quot;Error durante la escritura...&quot;, e)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   ... sube por throws ...&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;catch (PersistenciaException e) en MenuConsola, linea 87&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   ... y se recupera con ...&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;e.getCause().getMessage()&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Asi el usuario ve un mensaje del dominio y el programador&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;sigue teniendo el error tecnico original.&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;dashed=0;" vertex="1" parent="1"><mxGeometry x="700" y="1085" width="620" height="185" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pag-manejo" name="Manejo de excepciones">
    <mxGraphModel dx="1422" dy="798" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3t" value="Manejo de excepciones &amp;#183; donde se lanza, como sube y donde se captura" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1600" height="34" as="geometry"/></mxCell>
        <mxCell id="p3s" value="Las capas de abajo LANZAN (throw) y DECLARAN (throws). La vista es la unica que CAPTURA (catch). Ninguna excepcion cierra el programa." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1600" height="24" as="geometry"/></mxCell>
        <mxCell id="b1" value="1 &amp;#183; DONDE NACE  (throw)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="560" height="28" as="geometry"/></mxCell>
        <mxCell id="b2" value="2 &amp;#183; COMO SUBE  (throws)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="700" y="90" width="560" height="28" as="geometry"/></mxCell>
        <mxCell id="b3" value="3 &amp;#183; DONDE SE CAPTURA  (catch)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1360" y="90" width="560" height="28" as="geometry"/></mxCell>
        <mxCell id="o_modelo" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;modelo  (validaciones)&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;CataInvent.normalizarCodigo:36,40&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   throw new DatosInvalidosException(...)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;CataInvent.setNombreInventario:59,63,68&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;SaldosInventario constructor:29,33,37,41&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;SaldosInventario.aplicarEntrada:63,67&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Kardex constructor:31,35,38,41,45&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="580" height="135" as="geometry"/></mxCell>
        <mxCell id="o_stock" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;modelo  (regla de negocio)&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;SaldosInventario.aplicarSalida:87&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   throw new StockInsuficienteException(&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      &quot;...se piden N y solo hay M disponibles&quot;)&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;El metodo declara throws, por eso quien lo&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;llama esta obligado a manejarlo.&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="285" width="580" height="129" as="geometry"/></mxCell>
        <mxCell id="o_parseo" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;modelo  (lectura de disco)&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;CataInvent.desdeLinea:89,94&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;SaldosInventario.desdeLinea:155,159,173&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Kardex.desdeLinea:95,99,120&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Kardex.desdeLinea:103-120&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   try { ... parseInt / LocalDate.parse /&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;         TipoMovimiento.valueOf ... }&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   catch (DateTimeParseException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;          | IllegalArgumentException e)   MULTI-CATCH&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   throw new DatosInvalidosException(msg, e)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="434" width="580" height="185" as="geometry"/></mxCell>
        <mxCell id="o_servicio" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;servicio  (reglas de negocio)&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;registrarProducto:144&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   throw new CodigoDuplicadoException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;eliminarProducto:193&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   throw new IntegridadReferencialException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;buscarProducto:220&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   throw new ProductoNoEncontradoException&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="639" width="580" height="135" as="geometry"/></mxCell>
        <mxCell id="o_persistencia" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;persistencia  (disco)&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;crearSiNoExiste:100-103&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   catch (IOException e)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   throw new PersistenciaException(msg, e)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;leerTodos:148-150        error de LECTURA&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;guardarTodos:188-190     error de ESCRITURA&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;respaldar:222            no se creo la carpeta&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;respaldar:248-249        catch FileNotFoundException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;respaldar:251-252        catch IOException&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Orden de los catch: de lo mas especifico a lo&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;mas general. FileNotFoundException es hija de&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;IOException, al reves no compilaria.&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="794" width="580" height="213" as="geometry"/></mxCell>
        <mxCell id="pr1" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;ArchivoTxt.leerTodos() / guardarTodos() / respaldar()&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;throws PersistenciaException&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=0;" vertex="1" parent="1"><mxGeometry x="700" y="130" width="580" height="65" as="geometry"/></mxCell>
        <mxCell id="pr2" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;InventarioService  (metodos publicos)&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;throws CodigoDuplicadoException,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   ProductoNoEncontradoException,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   IntegridadReferencialException,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   StockInsuficienteException,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   PersistenciaException&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Antes de relanzar una PersistenciaException,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;REVIERTE la memoria:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   registrarProducto:155-162&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   modificarProducto:175-177&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   eliminarProducto:204-209&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   registrarEntrada:270-275&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   registrarSalida:303-306&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;catch (PersistenciaException e) { ...revierte...; throw e; }&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;dashed=0;" vertex="1" parent="1"><mxGeometry x="700" y="225" width="580" height="241" as="geometry"/></mxCell>
        <mxCell id="pr3" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;MenuConsola  (metodos de cada opcion)&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;registrarProducto() / eliminarProducto() /&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;registrarSalida() ... todos declaran throws&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;y NO capturan: dejan subir la excepcion.&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=0;" vertex="1" parent="1"><mxGeometry x="700" y="496" width="580" height="93" as="geometry"/></mxCell>
        <mxCell id="pr4" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;MenuConsola.iniciar()  &amp;amp;#8592;  FIN DEL VIAJE&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Aqui esta el unico try/catch del menu.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Linea 54: try { switch (opcion) { ... } }&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=0;" vertex="1" parent="1"><mxGeometry x="700" y="619" width="580" height="79" as="geometry"/></mxCell>
        <mxCell id="pe0" value="sube" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pr1" target="pr2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe1" value="sube" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pr2" target="pr3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe2" value="sube" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pr3" target="pr4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;MenuConsola.iniciar()  linea 75   MULTI-CATCH&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;catch (ProductoNoEncontradoException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;       | CodigoDuplicadoException e)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   System.out.println(&quot;[AVISO] &quot; + e.getMessage())&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=0;" vertex="1" parent="1"><mxGeometry x="1360" y="130" width="580" height="93" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;MenuConsola.iniciar()  linea 78   MULTI-CATCH&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;catch (StockInsuficienteException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;       | IntegridadReferencialException e)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   System.out.println(&quot;[OPERACION RECHAZADA] &quot; + ...)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=0;" vertex="1" parent="1"><mxGeometry x="1360" y="243" width="580" height="93" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;MenuConsola.iniciar()  linea 84   NO VERIFICADA&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;catch (DatosInvalidosException e)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   System.out.println(&quot;[DATO INVALIDO] &quot; + ...)&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;El compilador no obligaba a poner este catch,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;pero sin el un dato mal digitado cerraria el&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;programa con un volcado de pila.&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#ffcccc;strokeColor=#b85450;dashed=0;" vertex="1" parent="1"><mxGeometry x="1360" y="356" width="580" height="129" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;MenuConsola.iniciar()  linea 87   CON CAUSA&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;catch (PersistenciaException e)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   println(&quot;[ERROR DE ARCHIVO] &quot; + e.getMessage())&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   if (e.getCause() != null)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      println(&quot;Causa original: &quot; +&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;         e.getCause().getMessage())&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Ejemplo real de la prueba:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   [ERROR DE ARCHIVO] Error durante la escritura...&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   Causa original: AccessDeniedException:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;      datos\saldos.txt.tmp -&amp;gt; datos\saldos.txt&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=0;" vertex="1" parent="1"><mxGeometry x="1360" y="505" width="580" height="185" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;MenuConsola  capturas locales&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;leerEntero:306   catch (NumberFormatException e)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;leerDecimal:320  catch (NumberFormatException e)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   repiten la pregunta hasta recibir un numero&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;consultarInventario:198&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   catch (ProductoNoEncontradoException e)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   no puede ocurrir (el codigo sale del catalogo),&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   se captura porque el compilador lo exige&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=0;" vertex="1" parent="1"><mxGeometry x="1360" y="710" width="580" height="157" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;ArchivoTxt  capturas internas&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;leerTodos:140  catch (DatosInvalidosException e)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   una linea corrupta se DESCARTA con advertencia&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   y el ciclo CONTINUA con las demas lineas&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;guardarTodos:183  catch (AtomicMoveNotSupportedException e)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   reintenta el Files.move sin ATOMIC_MOVE&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;cerrarSilenciosamente:274  catch (IOException e)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   ignora el error de close()&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=0;" vertex="1" parent="1"><mxGeometry x="1360" y="887" width="580" height="165" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;Main.main()  linea 55   ULTIMA RED&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;catch (PersistenciaException e)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   mensaje claro + causa + cierre ordenado&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;main NO declara throws a proposito: si lo hiciera,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;la JVM imprimiria un volcado de pila tecnico.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Capturar es mas robusto que delegar.&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=0;" vertex="1" parent="1"><mxGeometry x="1360" y="1072" width="580" height="129" as="geometry"/></mxCell>
        <mxCell id="pc1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pr4" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="conceptos" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;Mapa de conceptos &amp;amp;#8594; donde verlos&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Excepcion VERIFICADA        InventarioException + 5 hijas&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Excepcion NO VERIFICADA     DatosInvalidosException,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;                            NumberFormatException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Excepciones personalizadas  todo el paquete excepciones&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;try / catch                 MenuConsola 54-101, ArchivoTxt,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;                            Main 40-55&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;finally                     ArchivoTxt.guardarTodos 191&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;                            (borra el .tmp)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;                            ArchivoTxt.respaldar 253&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;                            (cierra a mano)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;try-with-resources          ArchivoTxt.leerTodos 130&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;                            ArchivoTxt.guardarTodos 169&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;multi-catch                 MenuConsola 75 y 78,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;                            Kardex.desdeLinea 119&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;throw                       modelo y servicio&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;throws                      firmas de InventarioService&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;                            y de ArchivoTxt&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Encadenar la causa          PersistenciaException y&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;                            DatosInvalidosException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;                            (mensaje, causa) + getCause()&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Java I/O clasico            ArchivoTxt.respaldar 211-266&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;NIO.2 Path / Files          resto de ArchivoTxt, Main 32&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Persistencia                3 archivos txt: se cargan al&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;                            iniciar, se guardan tras cada&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;                            operacion&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;dashed=0;" vertex="1" parent="1"><mxGeometry x="2000" y="130" width="620" height="401" as="geometry"/></mxCell>
        <mxCell id="situaciones" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;Las 7 situaciones obligatorias del enunciado&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;1. Producto inexistente&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   InventarioService.buscarProducto:220&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   demo: opcion 4 con PRD-999&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;2. Codigo duplicado&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   InventarioService.registrarProducto:144&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   demo: opcion 1 dos veces con el mismo codigo&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;3. Datos invalidos&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   CataInvent y MenuConsola.leerEntero:306&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   demo: nombre vacio, o letras donde va cantidad&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;4. Archivo inexistente&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   ArchivoTxt.crearSiNoExiste:89-105&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   demo: borrar la carpeta datos y ejecutar&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;5. Archivo vacio&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   ArchivoTxt.leerTodos:122-125&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   demo: dejar los txt en cero bytes&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;6. Error durante la LECTURA&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   ArchivoTxt.leerTodos:148-150&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   demo: escribir una linea mal formada en kardex.txt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   se descarta esa linea y el resto si carga&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;7. Error durante la ESCRITURA&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   ArchivoTxt.guardarTodos:188-190&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   demo: marcar saldos.txt como solo lectura y&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   registrar una entrada&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;dashed=0;" vertex="1" parent="1"><mxGeometry x="2000" y="556" width="620" height="421" as="geometry"/></mxCell>
        <mxCell id="segura" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;Escritura segura + finally (ArchivoTxt.guardarTodos 164-209)&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;1. try-with-resources escribe TODO en saldos.txt.tmp&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;2. Files.move(tmp, real, REPLACE_EXISTING, ATOMIC_MOVE)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;3. si el sistema no soporta ATOMIC_MOVE, reintenta sin el&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;4. catch (IOException) -&amp;gt; PersistenciaException con causa&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;5. finally -&amp;gt; Files.deleteIfExists(tmp)&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Resultado: si el programa se corta a la mitad, el archivo&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;bueno queda intacto y lo unico perdido es el temporal.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;El finally garantiza que no quede basura .tmp ni cuando&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;todo sale bien ni cuando falla.&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=0;" vertex="1" parent="1"><mxGeometry x="2000" y="1002" width="620" height="185" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
