        <mxCell id="ex2e" value="&amp;#171;extend&amp;#187;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;endSize=8;strokeColor=#b85450;fontColor=#9a3b38;fontSize=10;" edge="1" parent="1" source="ex2" target="in2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ex3e" value="&amp;#171;extend&amp;#187;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;endSize=8;strokeColor=#b85450;fontColor=#9a3b38;fontSize=10;" edge="1" parent="1" source="ex3" target="in3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ex4e" value="&amp;#171;extend&amp;#187;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;endSize=8;strokeColor=#b85450;fontColor=#9a3b38;fontSize=10;" edge="1" parent="1" source="ex5" target="uc5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ex5e" value="&amp;#171;extend&amp;#187;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;endSize=8;strokeColor=#b85450;fontColor=#9a3b38;fontSize=10;" edge="1" parent="1" source="ex6" target="uc3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ex6e" value="&amp;#171;extend&amp;#187;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;endSize=8;strokeColor=#b85450;fontColor=#9a3b38;fontSize=10;" edge="1" parent="1" source="ex7" target="uc11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ar1" value="escribe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeWidth=1.5;" edge="1" parent="1" source="in3" target="actorArchivos"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ar2" value="lee" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeWidth=1.5;" edge="1" parent="1" source="uc11" target="actorArchivos"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ar3" value="copia" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeWidth=1.5;" edge="1" parent="1" source="uc10" target="actorArchivos"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4ley" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;Leyenda&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Elipse azul   =  caso de uso que el actor pide directamente&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Elipse verde  =  comportamiento compartido, incluido por varios casos&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Elipse roja   =  flujo de excepcion (lo que pasa cuando algo falla)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Linea continua       =  asociacion actor - caso de uso&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Flecha verde punteada &amp;amp;#171;include&amp;amp;#187;  =  el caso base SIEMPRE ejecuta al incluido&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Flecha roja punteada &amp;amp;#171;extend&amp;amp;#187;   =  el flujo solo ocurre si se da la condicion de error&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Las extensiones se cuelgan de los casos incluidos y no de cada caso base,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;porque la validacion y el guardado son los que realmente fallan. Asi el&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;diagrama dice lo mismo con muchas menos flechas.&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="1440" width="620" height="185" as="geometry"/></mxCell>
        <mxCell id="p4det" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;Que excepcion lanza cada flujo de error&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Rechazar codigo duplicado            CodigoDuplicadoException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Rechazar dato invalido               DatosInvalidosException (NO verificada)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Avisar producto inexistente          ProductoNoEncontradoException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Informar error de archivo            PersistenciaException (envuelve IOException)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Rechazar salida por stock            StockInsuficienteException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Rechazar eliminacion por integridad  IntegridadReferencialException&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Descartar linea corrupta             DatosInvalidosException capturada dentro&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;                                     de ArchivoTxt.leerTodos: se descarta la&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;                                     linea, se advierte y la carga continua&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Las seis primeras se capturan en MenuConsola.iniciar() y vuelven al menu:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;ninguna cierra el programa.&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;dashed=0;" vertex="1" parent="1"><mxGeometry x="700" y="1440" width="700" height="213" as="geometry"/></mxCell>
        <mxCell id="p4nota" value="&lt;p style=&quot;margin:0px;margin-top:3px;text-align:left;&quot;&gt;&lt;b&gt;Casos de uso que NO tienen flujo de excepcion&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Buscar producto por nombre (5)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   una busqueda sin resultados es un resultado valido,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   no un error: devuelve una lista vacia.&lt;/p&gt;&lt;p style=&quot;margin:0px;&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;Consultar inventario (6)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:7px;&quot;&gt;   si el catalogo esta vacio solo avisa y vuelve al menu.&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;dashed=0;" vertex="1" parent="1"><mxGeometry x="1440" y="1440" width="480" height="129" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
